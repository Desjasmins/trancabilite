# Connexion PostgreSQL — copiez ce fichier en `.env` et renseignez vos URLs.

# DATABASE_URL : utilisée par l'APPLICATION au runtime.
#   - En local  : votre Postgres (Docker, etc.)
#   - Sur Vercel : pooler transaction Supabase (port 6543) — adapté au serverless.
DATABASE_URL="postgresql://user:password@localhost:5432/tracabilite?schema=public"

# DIRECT_URL : utilisée par la CLI Prisma (db push / migrate / seed) pour les
#   migrations. Connexion directe ou session pooler (port 5432). Facultatif :
#   si absente, la CLI retombe sur DATABASE_URL.
# DIRECT_URL="postgresql://postgres.xxxx:password@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# Better Auth (comptes du Bureau)
BETTER_AUTH_SECRET="changez-moi-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000" # en prod : l'URL du déploiement

# Supabase Realtime (synchro temps réel des écrans). Sans ces clés, la synchro
# est simplement désactivée (l'app fonctionne). Dashboard Supabase -> Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://VOTRE-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre-cle-anon-publique"

# Photos de défaut (#23) — bucket Supabase Storage PRIVÉ, lu et signé côté serveur seulement.
# SECRET : jamais de préfixe NEXT_PUBLIC_ (elle contourne toutes les règles RLS).
# Dashboard Supabase -> Settings -> API -> service_role. Sans elle, l'envoi de photo est
# indisponible (message à l'écran) et le reste de l'app fonctionne.
SUPABASE_SERVICE_ROLE_KEY="votre-cle-service-role-secrete"
# Facultatif : nom du bucket (défaut nc-photos). Créer le bucket à la main : privé,
# 5 Mo max, types image/jpeg, image/png, image/webp, image/heic.
# SUPABASE_PHOTO_BUCKET="nc-photos"
